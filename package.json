{
  "name": "santrascan",
  "version": "1.0.0",
  "private": true,
  "description": "SantraScan: AI Orange Sapling Quality Assessment + Orange Book (Build Bridge)",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,green\" \"npm:backend\" \"npm:frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir backend",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
